{
  "name": "au-datacentre-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "Australian AI Data Centre Observatory",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "./scripts/test-rls.sh",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema facts --schema editorial > lib/database.types.ts",
    "test:load": "./scripts/test-load.sh",
    "test:ui": "./scripts/test-ui.sh",
    "load:pipeline": "tsx scripts/ingestion/load-pipeline.ts",
    "backup:export": "tsx scripts/backup/export-database.ts",
    "backup:verify": "tsx scripts/backup/export-database.ts --verify",
    "backup:restore": "tsx scripts/backup/restore-database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "leaflet": "^1.9.4",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "playwright": "^1.63.0",
    "postcss": "^8.4.47",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
