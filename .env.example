# Copy to .env.local for development. Never commit .env or .env.local.
# See docs/DEPLOYMENT.md for how these are set in Netlify and Supabase.

# Public: safe to expose to the browser. Read access is governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: bypasses RLS. Used by ingestion jobs and edge functions.
# Never reference this from anything under app/ or components/.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. How long, in seconds, the site may serve a database read before
# asking again. Defaults to 300; 0 turns caching off, for local work against a
# database being edited. See lib/supabase/cachePolicy.ts.
RECORD_CACHE_SECONDS=

# Optional. Enables POST /api/revalidate, which clears cached reads at once
# after a pipeline load or an editorial change. Unset, the endpoint does not
# exist. Use a long random value.
REVALIDATE_SECRET=

# Optional, but set both before launch. Map tiles default to OpenStreetMap's
# own servers, which are not a production tile service. MAP_TILE_URL is a
# Leaflet URL template; MAP_TILE_ATTRIBUTION is what the provider requires.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
